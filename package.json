{
  "name": "keisan-block",
  "version": "1.0.0",
  "description": "さんすうブロック — 小学1年生向けの けいさん れんしゅう（PWA）",
  "private": true,
  "license": "MIT",
  "type": "module",
  "_comment": "依存パッケージは持たない。ブラウザへ送る実行コードは 0 バイトで、ビルドもしない。ここにあるのは検査を走らせるための入口だけ。",
  "scripts": {
    "check": "node tools/build-sw.mjs --check && node scripts/check-project.mjs",
    "check:json": "node scripts/check-project.mjs --json",
    "test": "node --test tests/*.test.mjs",
    "icons": "python3 tools/make-icons.py",
    "serve": "python3 -m http.server 8000",
    "build:sw": "node tools/build-sw.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
